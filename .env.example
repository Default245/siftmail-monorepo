# Backend
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of origins allowed by CORS middleware
CORS_ORIGINS=http://localhost:3000
# Float between 0 and 1 for when to mark messages as suspicious
CLASSIFICATION_THRESHOLD=0.55
# Optional comma-separated keyword and domain lists for tuning
SPAM_KEYWORDS=lottery,winner,wire transfer,urgent,bitcoin,password
PHISHING_DOMAINS=example-phish.com,dodgy-payments.io

# Frontend
# Base URL where the FastAPI backend is reachable
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
